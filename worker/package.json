{
  "name": "pkr-reloaded-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute pkr-reloaded-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute pkr-reloaded-db --local --file=./schema.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:staging": "node scripts/check-staging-config.mjs",
    "dev:staging": "npm run check:staging && wrangler dev --config wrangler.staging.toml --local",
    "deploy:staging": "npm run check:staging && node scripts/check-staging-secrets.mjs && wrangler deploy --config wrangler.staging.toml"
  },
  "dependencies": {
    "hono": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240524.0",
    "typescript": "^5.4.5",
    "vitest": "^5.0.5",
    "wrangler": "^3.114.17"
  }
}
