{
  "name": "pkr-reloaded-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute pkr-reloaded-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute pkr-reloaded-db --local --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.4.0"
  },
  "devDependencies": {
    "wrangler": "^3.60.0",
    "@cloudflare/workers-types": "^4.20240524.0",
    "typescript": "^5.4.5"
  }
}
